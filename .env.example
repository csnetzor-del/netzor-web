# ----------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL / Render / Neon / Supabase)
# ----------------------------------------------------
DATABASE_URL="postgresql://user:password@hostname:5432/netzor_db?sslmode=require"

# ----------------------------------------------------
# AUTHENTICATION & APP URL
# ----------------------------------------------------
JWT_SECRET="change-this-to-a-long-random-secret-min-32-characters"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ----------------------------------------------------
# RAZORPAY PAYMENT GATEWAY
# ----------------------------------------------------
# Mode: "razorpay" (live/test) or "simulated" (local testing without API keys)
NETZOR_PAY_PROVIDER="razorpay"

# Razorpay API Keys (Get these from https://dashboard.razorpay.com/app/keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"

# Razorpay Webhook Secret (from Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# ----------------------------------------------------
# CONTACT & INTEGRATIONS
# ----------------------------------------------------
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/91XXXXXXXXXX?text=Hello%20NETZOR"
